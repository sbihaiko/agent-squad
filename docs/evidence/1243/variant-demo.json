{
  "format": "gui-test/1",
  "name": "variant-selector-demo",
  "target": "fake",
  "requires": {
    "actions": [
      "pad.press",
      "nav.goal",
      "window.mode"
    ],
    "checks": [
      "ui.focused",
      "ui.screen"
    ]
  },
  "variants": {
    "window.mode": [
      "windowed",
      "fullscreen"
    ]
  },
  "fixtures": {},
  "batches": [
    {
      "id": "b1",
      "setup": [],
      "teardown": [],
      "steps": [
        {
          "id": "b1.any",
          "role": "under-test",
          "precondition": "ui.screen == play.home",
          "action": {
            "name": "pad.press",
            "args": {
              "button": "Right",
              "ticks": 4
            }
          },
          "wait": {
            "check": "ui.focused == play.home.open-rom",
            "timeout_ticks": 120
          },
          "check": {
            "name": "ui.focused",
            "args": {
              "is": "play.home.open-rom"
            }
          },
          "expect": "the Open a ROM card has focus",
          "severity": "major",
          "mode": "automated"
        },
        {
          "id": "b1.win",
          "role": "under-test",
          "precondition": "ui.screen == play.home",
          "action": {
            "name": "pad.press",
            "args": {
              "button": "Right",
              "ticks": 4
            }
          },
          "wait": {
            "check": "ui.focused == play.home.open-rom",
            "timeout_ticks": 120
          },
          "check": {
            "name": "ui.focused",
            "args": {
              "is": "play.home.open-rom"
            }
          },
          "expect": "the Open a ROM card has focus",
          "severity": "major",
          "mode": "automated",
          "variants": {
            "window.mode": "windowed"
          }
        },
        {
          "id": "b1.fs",
          "role": "under-test",
          "precondition": "ui.screen == play.home",
          "action": {
            "name": "pad.press",
            "args": {
              "button": "Right",
              "ticks": 4
            }
          },
          "wait": {
            "check": "ui.focused == play.home.open-rom",
            "timeout_ticks": 120
          },
          "check": {
            "name": "ui.focused",
            "args": {
              "is": "play.home.open-rom"
            }
          },
          "expect": "the Open a ROM card has focus",
          "severity": "major",
          "mode": "automated",
          "variants": {
            "window.mode": "fullscreen"
          }
        }
      ]
    },
    {
      "id": "b2",
      "setup": [],
      "teardown": [],
      "steps": [
        {
          "id": "b2.a",
          "role": "under-test",
          "precondition": "ui.screen == play.home",
          "action": {
            "name": "pad.press",
            "args": {
              "button": "A",
              "ticks": 4
            }
          },
          "wait": {
            "check": "ui.screen == play.library",
            "timeout_ticks": 10
          },
          "check": {
            "name": "ui.screen",
            "args": {
              "is": "play.library"
            }
          },
          "expect": "the Open a ROM card has focus",
          "severity": "major",
          "mode": "automated"
        }
      ]
    }
  ]
}
