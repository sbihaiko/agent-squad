{
  "schema_version": 0,
  "name": "dev-squad-default",
  "description": "PROTOTYPE fixture for wayfinder ticket #11. The five dev_squad phases, the actor-critic loops, and the tier skips, written in the GLOSSARY.md vocabulary. Fields marked GAP are not in the vocabulary.",
  "root": "main",

  "facts": [
    { "name": "tier", "type": "enum", "values": ["trivial", "medium", "large"], "instrument": "code: classifyTier over scout.size_estimate (1 file/40 LoC, 3 files/200 LoC); missing estimate is large", "source": "scout" },
    { "name": "sensitive", "type": "bool", "instrument": "code: sensitive path set over scout.paths", "source": "scout" },
    { "name": "visual", "type": "bool", "instrument": "code: changed files and setup.webApp (dev_squad D8: computed before execute)", "source": "scout" },
    { "name": "git", "type": "bool", "instrument": "code: setup.gitAvailable", "source": "scout" },
    { "name": "work_items", "type": "int", "instrument": "code: length of decompose.work_items, or 1 synthetic item when decompose did not run", "source": "decompose" },
    { "name": "blocking_learnings", "type": "int", "instrument": "code: count of learnings in state blocking-in-review", "source": "memory (GAP: cross-run, not yet specified)" },
    { "name": "architecture_issues", "type": "int", "instrument": "code: count of architecture issues the critic emitted", "source": "run record" }
  ],

  "gates": [
    { "id": "ac-command-shape", "params": ["duplicate_warn_ratio"] },
    { "id": "plan-semantics", "params": ["max_work_items"] },
    { "id": "spend-floor", "params": ["min_remaining_usd"] },
    { "id": "scope", "params": ["allowed_generated"] },
    { "id": "security", "params": ["sensitive_paths"] },
    { "id": "size-backstop", "params": ["max_files", "max_added_lines"] },
    { "id": "ac-verify", "params": ["commands_from"] },
    { "id": "visual-guard", "params": [] },
    { "id": "learning-check", "params": [] }
  ],

  "nodes": [
    { "name": "main", "kind": "loop", "max": { "value": 1, "min": 1 },
      "children": ["scout", "spec", "plan", "budget_gate", "execute", "verify", "ship"] },

    { "name": "scout", "kind": "agent", "model": "sonnet", "tools": ["Read", "Grep", "Glob"],
      "budget": { "turns": { "min": 5, "max": 40 }, "spend": { "min": 0.05, "max": 2 } }, "deadline": 600,
      "output_key": "size_estimate" },

    { "name": "spec", "kind": "loop", "when": { "fact": "tier", "op": "ne", "value": "trivial" },
      "max": { "value": 4, "min": 1 }, "children": ["spec_draft", "spec_gate", "spec_proxy"] },
    { "name": "spec_draft", "kind": "agent", "model": "opus", "tools": ["Read", "Grep"],
      "budget": { "turns": { "min": 5, "max": 60 }, "spend": { "min": 0.1, "max": 4 } }, "deadline": 900,
      "output_key": "spec" },
    { "name": "spec_gate", "kind": "gate", "check": "ac-command-shape", "params": { "duplicate_warn_ratio": 0.4 } },
    { "name": "spec_proxy", "kind": "agent", "model": "opus", "tools": ["Read"],
      "budget": { "turns": { "min": 3, "max": 20 }, "spend": { "min": 0.05, "max": 2 } }, "deadline": 600 },

    { "name": "plan", "kind": "loop", "when": { "fact": "tier", "op": "eq", "value": "large" },
      "max": { "value": 4, "min": 1 }, "children": ["decompose", "plan_gate", "plan_proxy"] },
    { "name": "decompose", "kind": "agent", "model": "opus", "tools": ["Read", "Grep"],
      "budget": { "turns": { "min": 5, "max": 60 }, "spend": { "min": 0.1, "max": 4 } }, "deadline": 900,
      "output_key": "work_items" },
    { "name": "plan_gate", "kind": "gate", "check": "plan-semantics", "params": { "max_work_items": 5 } },
    { "name": "plan_proxy", "kind": "agent", "model": "opus", "tools": ["Read"],
      "budget": { "turns": { "min": 3, "max": 20 }, "spend": { "min": 0.05, "max": 2 } }, "deadline": 600 },

    { "name": "budget_gate", "kind": "gate", "check": "spend-floor", "params": { "min_remaining_usd": 1 },
      "next": { "fail": "exit:fail" } },

    { "name": "execute", "kind": "loop", "max": { "value": 1, "min": 1 },
      "for_each": "work_items",
      "_GAP": "for_each is not in the vocabulary. dev_squad runs batches in parallel; the four kinds have no fan-out.",
      "children": ["work", "merge", "manual_merge"] },
    { "name": "work", "kind": "loop", "max": { "value": 12, "min": 1 },
      "children": ["actor", "scope_gate", "security_gate", "size_backstop", "critic"] },
    { "name": "actor", "kind": "agent", "model": "sonnet", "tools": ["Read", "Edit", "Write", "Bash"],
      "budget": { "turns": { "min": 10, "max": 120 }, "spend": { "min": 0.2, "max": 8 } }, "deadline": 1800,
      "output_key": "diff" },
    { "name": "scope_gate", "kind": "gate", "check": "scope", "params": { "allowed_generated": ["package-lock.json"] } },
    { "name": "security_gate", "kind": "gate", "check": "security", "params": { "sensitive_paths": ["auth", "crypto", ".env*"] } },
    { "name": "size_backstop", "kind": "gate", "check": "size-backstop", "params": { "max_files": 1, "max_added_lines": 40 },
      "next": { "fail": "critic" } },
    { "name": "critic", "kind": "agent", "when": { "fact": "tier", "op": "ne", "value": "trivial" },
      "model": "opus", "tools": ["Read", "Grep"],
      "budget": { "turns": { "min": 3, "max": 30 }, "spend": { "min": 0.05, "max": 3 } }, "deadline": 900 },
    { "name": "merge", "kind": "agent", "model": "sonnet", "tools": ["Bash"],
      "budget": { "turns": { "min": 2, "max": 15 }, "spend": { "min": 0.02, "max": 1 } }, "deadline": 300,
      "next": { "fail": "manual_merge" } },
    { "name": "manual_merge", "kind": "wait", "owner": "rafael", "deadline": 86400, "default": "fail",
      "when": { "fact": "outcome:merge", "op": "eq", "value": "fail" },
      "next": { "fail": "exit:fail" } },

    { "name": "verify", "kind": "loop", "max": { "value": 1, "min": 1 },
      "children": ["ac_verify", "visual", "learning_gate", "audit_a", "audit_b", "audit_c"] },
    { "name": "ac_verify", "kind": "gate", "check": "ac-verify", "params": { "commands_from": "spec" },
      "next": { "fail": "exit:fail" } },
    { "name": "visual", "kind": "loop", "when": { "fact": "visual", "op": "eq", "value": true },
      "max": { "value": 4, "min": 1 }, "children": ["visual_actor", "visual_guard", "visual_critic"] },
    { "name": "visual_actor", "kind": "agent", "model": "sonnet", "tools": ["Bash", "Read"],
      "budget": { "turns": { "min": 5, "max": 40 }, "spend": { "min": 0.05, "max": 2 } }, "deadline": 600 },
    { "name": "visual_guard", "kind": "gate", "check": "visual-guard", "params": {} },
    { "name": "visual_critic", "kind": "agent", "model": "opus", "tools": ["Read"],
      "budget": { "turns": { "min": 3, "max": 20 }, "spend": { "min": 0.05, "max": 2 } }, "deadline": 600 },
    { "name": "learning_gate", "kind": "gate", "check": "learning-check", "params": {},
      "next": { "fail": "exit:fail" },
      "_note": "dev_squad T17 makes this node conditional. A gate may not carry a when, so it always runs and passes vacuously when blocking_learnings is 0." },
    { "name": "audit_a", "kind": "agent", "when": { "fact": "blocking_learnings", "op": "gt", "value": 0 },
      "model": "haiku", "tools": ["Read"], "budget": { "turns": { "min": 1, "max": 10 }, "spend": { "min": 0.01, "max": 0.5 } }, "deadline": 300,
      "next": { "fail": "continue", "deadline": "continue" } },
    { "name": "audit_b", "kind": "agent", "when": { "fact": "architecture_issues", "op": "gt", "value": 0 },
      "model": "haiku", "tools": ["Read"], "budget": { "turns": { "min": 1, "max": 10 }, "spend": { "min": 0.01, "max": 0.5 } }, "deadline": 300,
      "next": { "fail": "continue", "deadline": "continue" } },
    { "name": "audit_c", "kind": "agent", "when": { "fact": "work_items", "op": "gt", "value": 1 },
      "model": "haiku", "tools": ["Read"], "budget": { "turns": { "min": 1, "max": 10 }, "spend": { "min": 0.01, "max": 0.5 } }, "deadline": 300,
      "next": { "fail": "continue", "deadline": "continue" } },

    { "name": "ship", "kind": "loop", "max": { "value": 1, "min": 1 }, "children": ["commit"] },
    { "name": "commit", "kind": "agent", "when": { "fact": "git", "op": "eq", "value": true },
      "model": "haiku", "tools": ["Bash"], "budget": { "turns": { "min": 1, "max": 5 }, "spend": { "min": 0.01, "max": 0.2 } }, "deadline": 120,
      "_GAP": "A commit is deterministic code, not a model call and not a check. No kind fits." }
  ]
}
