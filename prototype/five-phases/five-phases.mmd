flowchart TD
subgraph main["main loop max 1"]
  direction TB
  scout["scout<br/>sonnet"]
  subgraph spec["spec loop max 4 when tier ne trivial"]
    direction TB
    spec_draft["spec_draft<br/>opus"]
    spec_gate{{"spec_gate<br/>gate: ac-command-shape"}}
    spec_proxy["spec_proxy<br/>opus"]
  end
  subgraph plan["plan loop max 4 when tier eq large"]
    direction TB
    decompose["decompose<br/>opus"]
    plan_gate{{"plan_gate<br/>gate: plan-semantics"}}
    plan_proxy["plan_proxy<br/>opus"]
  end
  budget_gate{{"budget_gate<br/>gate: spend-floor"}}
  subgraph execute["execute loop max 1 for each work_items"]
    direction TB
    subgraph work["work loop max 12"]
      direction TB
      actor["actor<br/>sonnet"]
      scope_gate{{"scope_gate<br/>gate: scope"}}
      security_gate{{"security_gate<br/>gate: security"}}
      size_backstop{{"size_backstop<br/>gate: size-backstop"}}
      critic["critic<br/>opus<br/>when tier ne trivial"]
    end
    merge["merge<br/>sonnet"]
    manual_merge(["manual_merge<br/>wait: rafael, 86400s"])
    execute_exit((exit))
  end
  subgraph verify["verify loop max 1"]
    direction TB
    ac_verify{{"ac_verify<br/>gate: ac-verify"}}
    subgraph visual["visual loop max 4 when visual eq true"]
      direction TB
      visual_actor["visual_actor<br/>sonnet"]
      visual_guard{{"visual_guard<br/>gate: visual-guard"}}
      visual_critic["visual_critic<br/>opus"]
    end
    learning_gate{{"learning_gate<br/>gate: learning-check"}}
    audit_a["audit_a<br/>haiku<br/>when blocking_learnings gt 0"]
    audit_b["audit_b<br/>haiku<br/>when architecture_issues gt 0"]
    audit_c["audit_c<br/>haiku<br/>when work_items gt 1"]
    verify_exit((exit))
  end
  subgraph ship["ship loop max 1"]
    direction TB
    commit["commit<br/>haiku<br/>when git eq true"]
  end
  main_exit((exit))
end
  scout -. fail: repeat .-> scout
  spec_draft -. fail: repeat .-> spec_draft
  spec_draft --> spec_gate
  spec_gate -. fail: repeat .-> spec_draft
  spec_gate --> spec_proxy
  spec_proxy -. fail: repeat .-> spec_draft
  scout --> spec
  decompose -. fail: repeat .-> decompose
  decompose --> plan_gate
  plan_gate -. fail: repeat .-> decompose
  plan_gate --> plan_proxy
  plan_proxy -. fail: repeat .-> decompose
  spec --> plan
  plan --> budget_gate
  budget_gate -. fail: exit:fail .-> main_exit
  actor -. fail: repeat .-> actor
  actor --> scope_gate
  scope_gate -. fail: repeat .-> actor
  scope_gate --> security_gate
  security_gate -. fail: repeat .-> actor
  security_gate --> size_backstop
  size_backstop -. fail .-> critic
  size_backstop --> critic
  critic -. fail: repeat .-> actor
  work --> merge
  merge -. fail .-> manual_merge
  merge --> manual_merge
  manual_merge -. fail: exit:fail .-> execute_exit
  budget_gate --> execute
  ac_verify -. fail: exit:fail .-> verify_exit
  visual_actor -. fail: repeat .-> visual_actor
  visual_actor --> visual_guard
  visual_guard -. fail: repeat .-> visual_actor
  visual_guard --> visual_critic
  visual_critic -. fail: repeat .-> visual_actor
  ac_verify --> visual
  visual --> learning_gate
  learning_gate -. fail: exit:fail .-> verify_exit
  learning_gate --> audit_a
  audit_a -. fail: continue .-> audit_a
  audit_a -. deadline: continue .-> audit_a
  audit_a --> audit_b
  audit_b -. fail: continue .-> audit_b
  audit_b -. deadline: continue .-> audit_b
  audit_b --> audit_c
  audit_c -. fail: continue .-> audit_c
  audit_c -. deadline: continue .-> audit_c
  execute --> verify
  commit -. fail: repeat .-> commit
  verify --> ship
  classDef gate fill:#eee,stroke:#333,stroke-width:2px
  classDef wait fill:#fff4d6,stroke:#333
  classDef cond stroke-dasharray: 5 5
  classDef ran fill:#cfe8cf,stroke:#2a6
  classDef skipped fill:#f6f6f6,stroke:#bbb,color:#999
  class spec_gate gate
  class plan_gate gate
  class budget_gate gate
  class scope_gate gate
  class security_gate gate
  class size_backstop gate
  class critic cond
  class manual_merge wait
  class manual_merge cond
  class ac_verify gate
  class visual_guard gate
  class learning_gate gate
  class audit_a cond
  class audit_b cond
  class audit_c cond
  class commit cond
